# ------------------------------------
# Marionette Element ID を取得
# ------------------------------------

$elementKey =
    "element-6066-11e4-a52e-4f735466cecf"


function Get-MarionetteElementId {

    param(
        $Element
    )

    # 直接 Element ID が返る場合
    if (
        $null -ne $Element.$elementKey
    ) {
        return $Element.$elementKey
    }

    # value 配下に Element ID が返る場合
    if (
        $null -ne $Element.value -and
        $null -ne $Element.value.$elementKey
    ) {
        return $Element.value.$elementKey
    }

    throw "Element ID を取得できませんでした。"
}


$userId =
    Get-MarionetteElementId $userElement

$passwordId =
    Get-MarionetteElementId $passwordElement

$buttonId =
    Get-MarionetteElementId $loginButton


Write-Host "    Username element ID: $userId"
Write-Host "    Password element ID: $passwordId"
Write-Host "    Login button element ID: $buttonId"