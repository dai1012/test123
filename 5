```powershell
# ----------------------------------------
# スクリーンショット取得
# ----------------------------------------

Write-Host "[9] スクリーンショットを取得します"


# ページ全体のサイズを取得します
$pageSize =
    Invoke-MarionetteScript `
        -Stream $stream `
        -Script @'
return {
    width: Math.max(
        document.body.scrollWidth,
        document.documentElement.scrollWidth
    ),
    height: Math.max(
        document.body.scrollHeight,
        document.documentElement.scrollHeight
    )
};
'@


Write-Host "    Page width : $($pageSize.width)"
Write-Host "    Page height: $($pageSize.height)"


# ページ全体が表示できるようにウィンドウサイズを変更します
$windowHeight = [Math]::Min(
    [int]$pageSize.height + 200,
    8000
)

Invoke-MarionetteCommand `
    -Stream $stream `
    -Command "WebDriver:SetWindowRect" `
    -Parameters @{
        x      = 0
        y      = 0
        width  = 1920
        height = $windowHeight
    } |
    Out-Null


Start-Sleep -Seconds 2


# スクリーンショットを取得します
$screenshot =
    Invoke-MarionetteCommand `
        -Stream $stream `
        -Command "WebDriver:TakeScreenshot" `
        -Parameters @{}


# Base64 データを PNG ファイルとして保存します
[System.IO.File]::WriteAllBytes(
    $ScreenshotPath,
    [System.Convert]::FromBase64String(
        $screenshot.value
    )
)


Write-Host "    スクリーンショット保存完了:"
Write-Host "    $ScreenshotPath"
```

