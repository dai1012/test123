# Firefox原生Zoomを70%に固定
Invoke-MarionetteCommand `
    -Stream $stream `
    -Command "Marionette:SetContext" `
    -Parameters @{ value = "chrome" } | Out-Null

Invoke-MarionetteCommand `
    -Stream $stream `
    -Command "WebDriver:ExecuteScript" `
    -Parameters @{
        script = "ZoomManager.zoom = 0.7; return ZoomManager.zoom;"
        args   = @()
    } | Out-Null

Invoke-MarionetteCommand `
    -Stream $stream `
    -Command "Marionette:SetContext" `
    -Parameters @{ value = "content" } | Out-Null